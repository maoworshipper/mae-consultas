DB_HOST=localhost
DB_NAME=dbname
DB_USER=user
DB_PASS=change_me
DB_CHARSET=utf8mb4
LEGACY_DB_ENABLED=false
LEGACY_DB_HOST=localhost
LEGACY_DB_NAME=dbname_legacy
LEGACY_DB_USER=user_legacy
LEGACY_DB_PASS=change_me
LEGACY_DB_CHARSET=utf8mb4
FEATURE_CERTIFICATE_ENABLED=true
FEATURE_CARD_ENABLED=true
APP_URL=https://tu-dominio.com
APP_KEY=change_this_to_a_long_random_secret

# Códigos QR en PDF de certificado y carnet (opcional; igual que mae-v8)
# Con QR_ENABLED=false no se genera QR: QR_VERIFICATION_URL y QR_REPLACE_PHOTO no se usan.
QR_ENABLED=false
# Solo cuando QR_ENABLED=true: URL que codificará el QR ({id} = id de cursos_inscritos).
# Si no la defines, se usa APP_URL + /index.php?certi={id}
# QR_VERIFICATION_URL=https://cursos.autolider.com.co/index.php?certi={id}
# Solo cuando QR_ENABLED=true: en carnet, true = el QR sustituye la foto del cliente
QR_REPLACE_PHOTO=false
