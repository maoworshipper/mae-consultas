# php -- BEGIN cPanel-generated handler, do not edit
# MAE Consultas requiere PHP 8.3. Ajuste en cPanel → Select PHP Version.
<IfModule mime_module>
  AddHandler application/x-httpd-ea-php83___lsphp .php .phtml
</IfModule>
# php -- END cPanel-generated handler, do not edit

# Compat: si el Document Root sigue siendo la raíz del proyecto,
# reescribe hacia public/. Preferible: apuntar el docroot a /public.

Options -Indexes

<IfModule mod_headers.c>
  Header always set X-Frame-Options "SAMEORIGIN"
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "no-referrer-when-downgrade"
  Header always set Strict-Transport-Security "max-age=31536000; includeSubDomains" env=HTTPS
  Header always set Permissions-Policy "geolocation=(), camera=(), microphone=(), payment=()"
</IfModule>

<FilesMatch "\.(sql|env|key|pem|inc|bak)$">
  <IfModule mod_authz_core.c>
    Require all denied
  </IfModule>
  <IfModule !mod_authz_core.c>
    Deny from all
  </IfModule>
</FilesMatch>

<FilesMatch "^(tenants\.secrets\.php|\.env)$">
  <IfModule mod_authz_core.c>
    Require all denied
  </IfModule>
  <IfModule !mod_authz_core.c>
    Deny from all
  </IfModule>
</FilesMatch>

<IfModule mod_rewrite.c>
  RewriteEngine On

  RewriteRule (^|/)\.|/\. - [F]

  RewriteRule ^public/ - [L]

  RewriteRule ^(app|config|branding|fpdf|scripts|docs|tests|\.git)/ - [F,NC,L]

  RewriteCond %{DOCUMENT_ROOT}/public/$1 -f [OR]
  RewriteCond %{DOCUMENT_ROOT}/public/$1 -d
  RewriteRule ^(.*)$ public/$1 [L]

  RewriteRule ^(.*)$ public/$1 [L]
</IfModule>
